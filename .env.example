# 默认模拟模式：不访问外部服务，也不加载本地大模型。
MOCK_LLM=true

# 用户提供 OpenAI 兼容接口后填写；密钥只放本机 .env，禁止提交。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# 默认保留混合思考；若追求最低延迟可显式设为 false。
LLM_ENABLE_THINKING=true
# 必须低于反向代理的 120 秒读超时，超时后会向界面返回可重试提示。
AGENT_RESPONSE_TIMEOUT_SECONDS=75

# 向量接口独立配置，必须返回 1024 维向量以匹配当前 pgvector 字段。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
EMBEDDING_API_TIMEOUT_SECONDS=15
# 只有 provider 支持 OpenAI 的 dimensions 参数时才填写；如 text-embedding-v4 可填 1024。
# 不支持时保持 0，并选用原生返回 1024 维的 embedding 模型。
EMBEDDING_API_DIMENSIONS=0
EMBEDDING_DIMENSION=1024
