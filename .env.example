# 默认模拟模式：不访问外部服务，也不加载本地大模型。
MOCK_LLM=true

# 用户提供 OpenAI 兼容接口后填写；密钥只放本机 .env，禁止提交。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# 向量接口独立配置，必须返回 384 维向量以匹配当前 pgvector 字段。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
EMBEDDING_API_TIMEOUT_SECONDS=15
EMBEDDING_DIMENSION=384
