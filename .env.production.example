# 复制为 .env.production；该文件含密钥，绝不能提交。
# 使用仅包含字母、数字的强密码，避免 DATABASE_URL 中的 URL 编码问题。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
APP_PORT=8080
# 默认仅允许服务器本机访问；临时公网体验可明确改为 0.0.0.0。
WEB_BIND_ADDRESS=127.0.0.1

# 构建阶段的 Python 依赖下载。跨境网络慢时可换用可信镜像，默认官方 PyPI。
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=300
PIP_RETRIES=5

# 上线时关闭 mock；真实 LLM 和 embedding 均须完整配置。
MOCK_LLM=false
LLM_BASE_URL=https://your-openai-compatible-provider/v1
LLM_API_KEY=replace_with_chat_api_key
LLM_MODEL=replace_with_chat_model_name
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# Qwen3.8 等混合思考模型默认保留推理；若追求最低延迟可设为 false。
LLM_ENABLE_THINKING=true
AGENT_RESPONSE_TIMEOUT_SECONDS=75

# 数据库的向量列固定为 1024 维。
EMBEDDING_BASE_URL=https://your-openai-compatible-provider/v1
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_API_MODEL=text-embedding-v4
# 若 provider 支持 OpenAI dimensions 参数，使用 1024；否则设为 0 并选择原生 1024 维模型。
EMBEDDING_API_DIMENSIONS=1024
EMBEDDING_API_TIMEOUT_SECONDS=15
EMBEDDING_DIMENSION=1024
