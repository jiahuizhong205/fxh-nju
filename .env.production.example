# 复制为 .env.production；该文件含密钥，绝不能提交。
# 使用仅包含字母、数字的强密码，避免 DATABASE_URL 中的 URL 编码问题。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
APP_PORT=8080

# 上线时关闭 mock；真实 LLM 和 embedding 均须完整配置。
MOCK_LLM=false
LLM_BASE_URL=https://your-openai-compatible-provider/v1
LLM_API_KEY=replace_with_chat_api_key
LLM_MODEL=replace_with_chat_model_name
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# 数据库的向量列固定为 384 维。
EMBEDDING_BASE_URL=https://your-openai-compatible-provider/v1
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_API_MODEL=text-embedding-3-small
# 若 provider 支持 OpenAI dimensions 参数，使用 384；否则设为 0 并选择原生 384 维模型。
EMBEDDING_API_DIMENSIONS=384
EMBEDDING_API_TIMEOUT_SECONDS=15
EMBEDDING_DIMENSION=384
