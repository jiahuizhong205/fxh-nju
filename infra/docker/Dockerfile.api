FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
# MOCK_LLM 默认开启，sentence-transformers 会额外拉取 torch/CUDA 依赖；
# 本镜像使用确定性 embedding 回退，真实 embedding 运行环境另行安装 requirements.ai.txt。
RUN grep -viE '^sentence-transformers' requirements.txt > /tmp/requirements.runtime.txt \
    && pip install --no-cache-dir -r /tmp/requirements.runtime.txt \
    && rm /tmp/requirements.runtime.txt

COPY . .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
